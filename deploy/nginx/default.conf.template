# 渲染变量：
#   VERIDEX_BACKEND_UPSTREAM — 默认 veridex-backend:8080，由编排层覆盖
#   NGINX_LOCAL_RESOLVERS    — 官方镜像 15-local-resolvers.envsh 从 /etc/resolv.conf 推导
#                              （K8s=kube-dns ClusterIP；Compose=127.0.0.11）
# 上游通过 resolver + 变量 proxy_pass 在请求时解析：backend 未就绪/DNS 未就绪时
# nginx 仍能正常启动（不 crash-loop），失败请求落到固定 502 错误页。
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # 与后端 spring.servlet.multipart max-request-size=55MB 对齐
  client_max_body_size 55m;

  # 本地存活检查（K8s readiness/liveness 与 Compose healthcheck 使用）
  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  # SSE 流式问答：关闭缓冲、放宽读超时
  location /api/ {
    set $backend_upstream "${VERIDEX_BACKEND_UPSTREAM}";
    proxy_pass http://$backend_upstream;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location = /v3/api-docs {
    set $backend_upstream "${VERIDEX_BACKEND_UPSTREAM}";
    proxy_pass http://$backend_upstream/v3/api-docs;
  }
  location /v3/api-docs/ {
    set $backend_upstream "${VERIDEX_BACKEND_UPSTREAM}";
    proxy_pass http://$backend_upstream;
  }

  # upstream 故障只回固定错误页，不暴露 backend 地址或内部细节
  error_page 502 503 504 /error_page.html;
  location = /error_page.html {
    internal;
  }

  # 管理端点（/actuator）绝不经 web 暴露：显式 404，不走 SPA fallback
  location /actuator/ {
    return 404;
  }

  # SPA fallback 与缓存策略
  location = /index.html {
    add_header Cache-Control "no-cache";
  }
  location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  location / {
    try_files $uri $uri/ /index.html;
  }
}
